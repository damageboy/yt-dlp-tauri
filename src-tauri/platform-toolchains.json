      "arch": "x86_64",
      "provider": { "kind": "archive-manifest", "manifestTarget": "win-x64" },
      "sourceLabels": { "managed": "Managed", "local": "Local" },
      "defaultSource": "managed",
      "executableNames": {
        "ytDlp": "yt-dlp.exe",
        "ffmpeg": "ffmpeg.exe",
        "ffprobe": "ffprobe.exe",
        "deno": "deno.exe"
      },
      "capabilities": { "install": true, "update": true, "reinstall": true }
    },
